# Copiar este archivo a ".env" y ajustar los valores antes de desplegar.

# Generar una clave larga y aleatoria, por ejemplo con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

DJANGO_DEBUG=False

# Hosts/dominios desde los que se puede servir el sitio (separados por coma).
# Incluye el hostname que te entregue cloudflared si usas un dominio propio.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Necesario si accedes por HTTPS a través de un dominio (cloudflared tunnel).
# Ejemplo: https://patentes.tudominio.com
DJANGO_CSRF_TRUSTED_ORIGINS=

DJANGO_TIME_ZONE=America/Santiago

# Solo si usas el servicio "cloudflared" incluido en docker-compose.yml.
# Se obtiene al crear un tunnel en el dashboard de Cloudflare Zero Trust.
CLOUDFLARE_TUNNEL_TOKEN=
